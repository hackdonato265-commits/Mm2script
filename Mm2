    L.Font = Enum.Font.Gotham; L.TextSize = 10
    L.TextXAlignment = Enum.TextXAlignment.Left; L.BackgroundTransparency = 1; L.Parent = F
    local SB = Instance.new("Frame")
    SB.Size = UDim2.new(1,-16,0,8); SB.Position = UDim2.new(0,8,0,24)
    SB.BackgroundColor3 = Color3.fromRGB(45,45,60); SB.Parent = F
    Instance.new("UICorner", SB).CornerRadius = UDim.new(0,4)
    local Fi = Instance.new("Frame")
    Fi.Size = UDim2.new((dflt-mn)/(mx-mn),0,1,0); Fi.BackgroundColor3 = Color3.fromRGB(255,85,85); Fi.Parent = SB
    Instance.new("UICorner", Fi).CornerRadius = UDim.new(0,4)
    local drag = false
    local function Upd(input)
        local pos = math.clamp((input.Position.X - SB.AbsolutePosition.X) / SB.AbsoluteSize.X, 0, 1)
        local v = math.floor(mn + (mx-mn)*pos)
        Fi.Size = UDim2.new(pos,0,1,0); L.Text = text..": "..tostring(v); cb(v)
    end
    SB.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = true; Upd(i) end end)
    UserInputService.InputChanged:Connect(function(i) if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then Upd(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end end)
