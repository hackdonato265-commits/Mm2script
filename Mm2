local RoleCache = {}
local function HasToolIn(player, names)
    if not player then return false end
    local char, bp = player.Character, player:FindFirstChild("Backpack")
    local function ck(c)
        if not c then return false end
        for _,n in ipairs(names) do local it=c:FindFirstChild(n); if it and it:IsA("Tool") then return true end end
        return false
    end
    return ck(char) or ck(bp)
end

local function GetPlayerRole(player)
    if not player then return "Innocent" end
    local c = RoleCache[player]
    if c and (tick()-c.t) < 0.4 then return c.role end
    local role = "Innocent"
    if HasToolIn(player, {"Gun","Revolver"}) then role = "Sheriff"
    elseif HasToolIn(player, {"Knife"}) then role = "Murderer" end
    RoleCache[player] = {role=role, t=tick()}
    return role
end

local CurrentMurderer, CurrentSheriff = nil, nil
local function UpdateRoles()
    CurrentMurderer, CurrentSheriff = nil, nil
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local r = GetPlayerRole(p)
                if r == "Murderer" then CurrentMurderer = p
                elseif r == "Sheriff" then CurrentSheriff = p end
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do UpdateRoles() end
end)

local function IsValidCoin(o)
    if not o or not o:IsA("BasePart") then return false end
    if o.Transparency >= 0.9 or o.Name ~= "Coin" then return false end
    if not o:FindFirstChildOfClass("TouchInterest") then return false end
    return true
end

local function FindNearestCoin(fromPos, maxRange)
    maxRange = maxRange or 200
    local nearest, best = nil, maxRange
    local roots = {}
    local cc = Workspace:FindFirstChild("CoinContainer", true); if cc then table.insert(roots, cc) end
    local nm = Workspace:FindFirstChild("Normal", true);        if nm then table.insert(roots, nm) end
    table.insert(roots, Workspace)
    local seen = {}
    for _, r in ipairs(roots) do
        for _, o in ipairs(r:GetDescendants()) do
            if not seen[o] then
                seen[o] = true
                if IsValidCoin(o) then
                    local d = (o.Position - fromPos).Magnitude
                    if d < best then best = d; nearest = o end
                end
            end
        end
    end
    return nearest, best
end

