RunService.RenderStepped:Connect(function()
    local c = LocalPlayer.Character
    if not c or not c:FindFirstChild("HumanoidRootPart") then return end
    local myHrp = c.HumanoidRootPart

    -- Bring original continuo
    if Config.Bring.Murderer or Config.Bring.Sheriff or Config.Bring.Innocent then
        local targetCFrame = myHrp.CFrame * CFrame.new(0, 0, -Config.Bring.Distance)
        for _,tp in ipairs(Players:GetPlayers()) do
            if tp ~= LocalPlayer and tp.Character then
                local role = GetPlayerRole(tp)
                local shouldBring = false
                if role == "Murderer" and Config.Bring.Murderer then shouldBring = true end
                if role == "Sheriff" and Config.Bring.Sheriff then shouldBring = true end
                if role == "Innocent" and Config.Bring.Innocent then shouldBring = true end

                if shouldBring then
                    local h = tp.Character:FindFirstChild("HumanoidRootPart")
                    if h then
                        h.CFrame = targetCFrame
                        h.Velocity = Vector3.zero
                        for _,pt in ipairs(tp.Character:GetChildren()) do
                            if pt:IsA("BasePart") then pt.CanCollide = false end
                        end
                    end
                end
            end
        end
    end

    -- Bring de Arma cuando está libre en el suelo
    if Config.Bring.GunDrop then
        for _,n in ipairs({"GunDrop", "Gun", "Revolver"}) do
            local drop = Workspace:FindFirstChild(n)
            if drop then
                local part = drop:IsA("BasePart") and drop or drop:FindFirstChildOfClass("BasePart")
                if part then
                    part.CFrame = myHrp.CFrame
                    part.Velocity = Vector3.zero
                    if firetouchinterest then
                        pcall(function()
                            firetouchinterest(myHrp, part, 0)
                            task.wait(0.01)
                            firetouchinterest(myHrp, part, 1)
                        end)
                    end
                end
            end
        end
    end
end)

-- Fling Spin All
local function FlingLoop()
    task.spawn(function()
        while Config.Fling.Active do
            for _,tp in ipairs(Players:GetPlayers()) do
                if not Config.Fling.Active then break end
                if tp ~= LocalPlayer and tp.Character then
                    local c = LocalPlayer.Character
                    local tC = tp.Character
                    local hrp = c and c:FindFirstChild("HumanoidRootPart")
                    local tH = tC and tC:FindFirstChild("HumanoidRootPart")
                    local tHm = tC and tC:FindFirstChildOfClass("Humanoid")
                    if hrp and tH and tHm and tHm.Health>0 then
                        local bav = Instance.new("BodyAngularVelocity")
                        bav.MaxTorque = Vector3.new(0,math.huge,0)
                        bav.AngularVelocity = Vector3.new(0,999999,0); bav.Parent = hrp
                        local st = tick()
                        while Config.Fling.Active and (tick()-st<1.8) and tH and tH.Parent do
                            hrp.CFrame = tH.CFrame; hrp.Velocity = Vector3.zero
                            for _,p in ipairs(c:GetChildren()) do
                                if p:IsA("BasePart") then p.CanCollide = false end
                            end
                            task.wait()
                        end
                        bav:Destroy(); task.wait(0.1)
                    end
                end
            end
            task.wait(0.3)
        end
    end)
end
