local ESP_Storage = {}
local function ClearESP(p)
    if ESP_Storage[p] then
        if ESP_Storage[p].H then ESP_Storage[p].H:Destroy() end
        if ESP_Storage[p].B then ESP_Storage[p].B:Destroy() end
        ESP_Storage[p] = nil
    end
end
local function ApplyESP(p)
    if p == LocalPlayer or not p.Character then return end
    local char = p.Character
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if not ESP_Storage[p] then ESP_Storage[p] = {} end
    local role = GetPlayerRole(p)
    local color = Config.ESP.InnocentColor
    if role == "Murderer" then color = Config.ESP.MurderColor
    elseif role == "Sheriff" then color = Config.ESP.SheriffColor end
    if not ESP_Storage[p].H then
        local hl = Instance.new("Highlight")
        hl.FillTransparency=0.5; hl.OutlineTransparency=0
        hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent=char
        ESP_Storage[p].H = hl
    end
    ESP_Storage[p].H.FillColor=color; ESP_Storage[p].H.OutlineColor=color
    ESP_Storage[p].H.Enabled = Config.ESP.Enabled
    if not ESP_Storage[p].B then
        local bb = Instance.new("BillboardGui")
        bb.Size=UDim2.new(0,200,0,40); bb.AlwaysOnTop=true; bb.StudsOffset=Vector3.new(0,3,0)
        local l = Instance.new("TextLabel")
        l.Size=UDim2.new(1,0,1,0); l.BackgroundTransparency=1
        l.Font=Enum.Font.GothamBold; l.TextSize=11
        l.TextColor3=Color3.fromRGB(255,255,255); l.TextStrokeTransparency=0; l.Parent=bb
        bb.Parent=hrp; ESP_Storage[p].B=bb
    end
    local text = ""
    if Config.ESP.ShowNames then text = text..p.DisplayName.."\n" end
    text = text.."["..role.."]"
    if Config.ESP.ShowDistance and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        text = text.." ("..math.floor((hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude).."m)"
    end
    local lbl = ESP_Storage[p].B:FindFirstChildOfClass("TextLabel")
    if lbl then lbl.Text=text; lbl.TextColor3=color end
    ESP_Storage[p].B.Enabled = Config.ESP.Enabled
end
